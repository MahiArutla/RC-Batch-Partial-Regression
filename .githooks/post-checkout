#!/bin/bash
# Post-checkout hook to automatically install dependencies when package-lock.json changes

PREV_COMMIT=$1
POST_COMMIT=$2
BRANCH_CHECKOUT=$3

# Check if package-lock.json has changed
CHANGED=$(git diff --name-only $PREV_COMMIT $POST_COMMIT | grep "package-lock.json")

if [ -n "$CHANGED" ]; then
    echo "package-lock.json changed, running npm install..."
    npm install
fi
